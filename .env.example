# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vestibular_estudos
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
DB_SSL=false

# Alternative database URL, optional
DATABASE_URL=
DB_URL=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=liquid/lfm-3-1.7b:free
OPENROUTER_SITE_URL=http://localhost/estudai
OPENROUTER_SITE_NAME=EstudAI
OPENROUTER_TIMEOUT_SECONDS=90

# Scheduled jobs, optional
ESTUDAI_CRON_TOKEN=

ESTUDAI_AI_DISABLED=true

# Local test controls. A private budget file is required for real requests.
ESTUDAI_AI_FEATURES=
ESTUDAI_AI_ALLOWED_USERS=
ESTUDAI_AI_BUDGET_FILE=
ESTUDAI_AI_MAX_REQUESTS=0
